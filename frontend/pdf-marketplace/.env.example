# Public frontend configuration.
# Copy this file to `.env` and replace placeholders with your local values.

# Optional. Leave blank to call same-origin /api routes.
# Local dev can use the Vite proxy, or set this to http://localhost:8081 if CORS is enabled.
VITE_API_BASE_URL=

# Optional local dev proxy target. Defaults to http://localhost:8081.
VITE_API_PROXY_TARGET=http://localhost:8081

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id
